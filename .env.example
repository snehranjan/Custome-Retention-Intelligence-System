# ==============================================================================
# Indian E-Commerce Customer Retention Intelligence System
# Environment Configuration Template
# NOTE: Copy this file to .env and adjust variables as needed.
# NEVER commit actual secrets or credentials to version control.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME="Indian E-Commerce Customer Retention Intelligence System"

# CORS Configuration (JSON array or comma-separated list of allowed origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Database & Supabase Integration (Optional - Phase 7.4)
# Leave blank to operate in local fallback demonstration mode (reading from CSV datasets)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_LOCAL_FALLBACK=true

# Authentication Settings (Phase 7.5 placeholder)
# JWT_SECRET_KEY=change_this_to_a_secure_random_string_in_production
# ACCESS_TOKEN_EXPIRE_MINUTES=60
