# ==============================================================================
# RetainIQ Frontend Environment Configuration Example
# Copy this file to .env.local and populate with your environment values.
# NEVER commit .env.local or real secrets to version control.
# ==============================================================================

# Supabase Identity & Auth Configuration (Public Anon Key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# FastAPI Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000
